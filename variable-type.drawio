                <!-- Section: .xshrc defines -->
                <mxCell id="hdr_xshrc" value="Defined in ~/.xshrc  (sourced at login)" style="text;html=1;strokeColor=none;fillColor=#c9dff5;align=left;verticalAlign=middle;spacingLeft=8;rounded=1;fontSize=11;fontStyle=2;fontColor=#23445D;" vertex="1" parent="shell_env">
