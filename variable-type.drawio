                </mxCell>

                <!-- XSH_HOME -->
                <mxCell id="xsh_home" value="&lt;b&gt;XSH_HOME&lt;/b&gt;&lt;br&gt;Default: &lt;tt&gt;~/.xsh&lt;/tt&gt;&lt;br&gt;&lt;font color=&apos;#006600&apos;&gt;&lt;tt&gt;export XSH_HOME=${XSH_HOME:-~/.xsh}&lt;/tt&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="shell_env">
                    <mxGeometry x="14" y="80" width="412" height="60" as="geometry"/>
                </mxCell>

                <!-- XSH_DEV_HOME -->
                <mxCell id="xsh_dev_home" value="&lt;b&gt;XSH_DEV_HOME&lt;/b&gt;&lt;br&gt;Default: &lt;tt&gt;$XSH_HOME/lib-dev&lt;/tt&gt;&lt;br&gt;&lt;font color=&apos;#006600&apos;&gt;&lt;tt&gt;export XSH_DEV_HOME=${XSH_DEV_HOME:-...}&lt;/tt&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="shell_env">
                    <mxGeometry x="14" y="152" width="412" height="60" as="geometry"/>
                </mxCell>

