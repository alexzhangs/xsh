                </mxCell>

                <!-- XSH_DEV -->
                <mxCell id="xsh_dev" value="&lt;b&gt;XSH_DEV&lt;/b&gt;&lt;br&gt;Any non-empty value loads libraries from &lt;tt&gt;XSH_DEV_HOME&lt;/tt&gt; instead of &lt;tt&gt;XSH_LIB_HOME&lt;/tt&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="shell_env">
